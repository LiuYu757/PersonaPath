{
  "knowledge_tree": {
    "title": "数字电子技术基础",
    "content": "数字电子技术基础是自动化类专业的核心课程，主要研究数字电路的基本概念、分析方法和设计方法，以及常用数字集成电路的原理与应用。",
    "difficulty": "2",
    "children": [
      {
        "title": "数制与码制",
        "content": "介绍数字系统中数的表示方法，包括不同进制数的转换和常用编码。",
        "difficulty": "1",
        "children": [
          {
            "title": "数制",
            "content": "用数字符号按位权展开表示数值的方法。",
            "difficulty": "1",
            "children": [
              {
                "title": "二进制",
                "content": "基数为2的计数制，使用0和1两个数码，是数字电路的基础。",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "八进制",
                "content": "基数为8的计数制，是二进制的紧凑表示形式。",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "十六进制",
                "content": "基数为16的计数制，是二进制的紧凑表示形式。",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "进制转换",
                "content": "不同进制数之间的相互转换方法。",
                "difficulty": "2",
                "children": []
              }
            ]
          },
          {
            "title": "码制",
            "content": "用特定二进制代码表示数值或信息的方法。",
            "difficulty": "1",
            "children": [
              {
                "title": "BCD码",
                "content": "用4位二进制数表示1位十进制数的编码。",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "格雷码",
                "content": "任意两个相邻代码之间只有一位不同的循环码。",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "ASCII码",
                "content": "美国标准信息交换码，用于字符表示。",
                "difficulty": "1",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "title": "逻辑代数基础",
        "content": "研究逻辑变量和逻辑运算的数学工具，是数字电路分析和设计的理论基础。",
        "difficulty": "2",
        "children": [
          {
            "title": "基本逻辑运算",
            "content": "与、或、非三种基本逻辑运算。",
            "difficulty": "1",
            "children": [
              {
                "title": "与运算",
                "content": "所有输入为1时输出才为1的逻辑运算。",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "或运算",
                "content": "任一输入为1时输出就为1的逻辑运算。",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "非运算",
                "content": "输出与输入相反的逻辑运算。",
                "difficulty": "1",
                "children": []
              }
            ]
          },
          {
            "title": "复合逻辑运算",
            "content": "由基本逻辑运算组合而成的运算。",
            "difficulty": "2",
            "children": [
              {
                "title": "与非运算",
                "content": "先与后非的复合逻辑运算。",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "或非运算",
                "content": "先或后非的复合逻辑运算。",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "异或运算",
                "content": "两个输入不同时输出为1的逻辑运算。",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "同或运算",
                "content": "两个输入相同时输出为1的逻辑运算。",
                "difficulty": "2",
                "children": []
              }
            ]
          },
          {
            "title": "逻辑代数基本定理",
            "content": "逻辑代数的基本定律和定理。",
            "difficulty": "3",
            "children": [
              {
                "title": "德摩根定理",
                "content": "与运算和或运算之间的对偶关系定理。",
                "difficulty": "3",
                "children": []
              },
              {
                "title": "吸收律",
                "content": "逻辑表达式的简化定理。",
                "difficulty": "3",
                "children": []
              },
              {
                "title": "对偶规则",
                "content": "逻辑表达式中的与或互换、0-1互换规则。",
                "difficulty": "3",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "title": "组合逻辑电路",
        "content": "输出只取决于当前输入状态的逻辑电路。",
        "difficulty": "3",
        "children": [
          {
            "title": "组合电路分析",
            "content": "已知逻辑电路图，分析其逻辑功能的方法。",
            "difficulty": "3",
            "children": [
              {
                "title": "真值表法",
                "content": "通过列出所有输入组合对应的输出值来分析电路功能。",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "逻辑表达式法",
                "content": "通过写出逻辑函数表达式来分析电路功能。",
                "difficulty": "3",
                "children": []
              }
            ]
          },
          {
            "title": "组合电路设计",
            "content": "根据逻辑功能要求设计实现电路的方法。",
            "difficulty": "4",
            "children": [
              {
                "title": "逻辑化简",
                "content": "使用卡诺图或公式法简化逻辑表达式。",
                "difficulty": "4",
                "children": []
