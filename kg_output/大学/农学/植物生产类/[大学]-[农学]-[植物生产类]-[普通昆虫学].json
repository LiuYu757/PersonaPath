  "knowledge_tree": {
    "title": "普通昆虫学",
    "content": "植物生产类专业核心课程，系统讲授昆虫形态、结构、生理、生物学、分类与生态及其在农业中的应用",
    "difficulty": "3",
    "children": [
      {
        "title": "昆虫纲基本特征",
        "content": "体分头、胸、腹三段；具1对触角、3对足、通常2对翅；气管系统呼吸；马氏管排泄；变态发育",
        "difficulty": "1",
        "children": [
          {
            "title": "体躯分段",
