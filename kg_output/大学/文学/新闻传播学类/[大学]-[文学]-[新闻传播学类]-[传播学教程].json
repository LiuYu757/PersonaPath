  "knowledge_tree": {
    "title": "传播学教程",
    "content": "传播学基础理论与应用",
    "difficulty": "1",
    "children": [
      {
        "title": "传播的基本概念",
        "content": "传播的定义、要素与功能",
        "difficulty": "1",
        "children": [
          {
            "title": "传播的定义",
            "content": "社会信息的传递或社会信息系统的运行",
            "difficulty": "1",
            "children": []
          },
          {
            "title": "传播的基本要素",
            "content": "传播者、受传者、讯息、媒介、反馈、噪音",
            "difficulty": "1",
            "children": []
          },
          {
            "title": "传播的基本功能",
            "content": "拉斯韦尔三功能说（环境监视、社会协调、社会遗产传承）和赖特的四功能说（增加娱乐功能）",
            "difficulty": "2",
            "children": []
          }
        ]
      },
      {
        "title": "人类传播的历史与发展",
        "content": "从符号到大众传播的演进过程",
        "difficulty": "2",
        "children": [
          {
            "title": "口语传播时代",
            "content": "人类传播活动第一个发展阶段，依赖于发声器官",
            "difficulty": "1",
            "children": []
          },
          {
            "title": "文字传播时代",
            "content": "文字发明使信息得以长期保存",
            "difficulty": "1",
            "children": []
          },
          {
            "title": "印刷传播时代",
            "content": "始于印刷机的发明，实现信息批量生产",
            "difficulty": "1",
            "children": []
          },
          {
            "title": "电子传播时代",
            "content": "信息远距离快速传输成为可能",
            "difficulty": "1",
            "children": []
          }
        ]
      },
      {
        "title": "传播的主要类型",
        "content": "五种基本传播类型及其特点",
        "difficulty": "2",
        "children": [
          {
            "title": "人内传播",
            "content": "个人接受外部信息并在体内处理的活动",
            "difficulty": "1",
            "children": [
              {
                "title": "米德的'主我与客我'理论",
                "content": "自我意识'主我'与'客我'的互动形成人内传播",
                "difficulty": "3",
                "children": []
              }
            ]
          },
          {
            "title": "人际传播",
            "content": "个人与个人之间的信息传播活动",
            "difficulty": "1",
            "children": []
          },
          {
            "title": "群体传播",
            "content": "群体内部的信息传播活动",
            "difficulty": "2",
            "children": [
              {
                "title": "群体压力与趋同心理",
                "content": "信息在群体中传播时会受到群体压力的影响",
                "difficulty": "3",
                "children": []
              }
            ]
          },
          {
            "title": "组织传播",
            "content": "组织所从事的信息活动",
            "difficulty": "2",
            "children": []
          },
          {
            "title": "大众传播",
            "content": "专业媒介组织运用传播技术广泛、快速、连续传播信息",
            "difficulty": "2",
            "children": [
              {
                "title": "大众传播的特点",
                "content": "传播者专业化、讯息公开性、受众广泛匿名、反馈间接性",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "大众传播的社会功能",
                "content": "环境监视、社会联系与协调、社会遗产传承、娱乐",
                "difficulty": "2",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "title": "传播模式与理论",
        "content": "传播过程模式与主要传播理论",
        "difficulty": "3",
        "children": [
          {
            "title": "线性传播模式",
            "content": "单向直线传播过程描述",
            "difficulty": "2",
            "children": [
              {
                "title": "拉斯韦尔的5W模式",
