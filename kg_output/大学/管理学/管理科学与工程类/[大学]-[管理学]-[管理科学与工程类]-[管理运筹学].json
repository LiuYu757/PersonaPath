            "children": [
              {
                "title": "乐观准则",
                "content": "从各方案最大收益中再取最大值的决策准则。",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "悲观准则",
                "content": "从各方案最小收益中取最大值的决策准则。",
