{
  "knowledge_tree": {
    "title": "会计学",
    "content": "会计学是研究财务信息的确认、计量、记录和报告的学科，为经济决策提供信息支持",
    "difficulty": "1",
    "children": [
      {
        "title": "会计基本理论",
        "content": "会计学的基础理论框架和基本概念体系",
        "difficulty": "1",
        "children": [
          {
            "title": "会计的定义",
            "content": "会计是以货币为主要计量单位，运用专门的方法，对经济活动进行连续、系统、全面的核算和监督的一种管理活动",
            "difficulty": "1",
            "children": []
          },
          {
            "title": "会计的基本职能",
            "content": "会计核算和会计监督是会计的两大基本职能",
            "difficulty": "1",
            "children": [
              {
                "title": "会计核算职能",
                "content": "通过确认、计量、记录和报告等环节，对经济活动进行反映",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "会计监督职能",
                "content": "对经济活动的合法性、合理性和有效性进行审查和监督",
                "difficulty": "1",
                "children": []
              }
            ]
          },
          {
            "title": "会计基本假设",
            "content": "会计核算的基本前提条件",
            "difficulty": "2",
            "children": [
              {
                "title": "会计主体假设",
                "content": "会计核算应当以企业发生的各项交易或事项为对象，记录和反映企业本身的各项生产经营活动",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "持续经营假设",
                "content": "会计核算应当以企业持续、正常的生产经营活动为前提",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "会计分期假设",
                "content": "将企业持续不断的生产经营活动划分为连续的、长短相同的期间",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "货币计量假设",
                "content": "会计核算以货币为主要计量单位",
                "difficulty": "2",
                "children": []
              }
            ]
          },
          {
            "title": "会计信息质量要求",
            "content": "会计信息应具备的基本质量特征",
            "difficulty": "2",
            "children": [
              {
                "title": "可靠性",
                "content": "企业应当以实际发生的交易或事项为依据进行会计确认、计量和报告",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "相关性",
                "content": "企业提供的会计信息应当与财务会计报告使用者的经济决策需要相关",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "可理解性",
                "content": "企业提供的会计信息应当清晰明了，便于理解和使用",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "可比性",
                "content": "企业提供的会计信息应当具有可比性",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "实质重于形式",
                "content": "企业应当按照交易或事项的经济实质进行会计确认、计量和报告",
                "difficulty": "3",
                "children": []
              },
              {
                "title": "重要性",
                "content": "企业提供的会计信息应当反映与企业财务状况、经营成果和现金流量等有关的所有重要交易或事项",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "谨慎性",
                "content": "企业对交易或事项进行会计确认、计量和报告应当保持应有的谨慎",
                "difficulty": "3",
                "children": []
              },
              {
                "title": "及时性",
                "content": "企业对于已经发生的交易或事项，应当及时进行会计确认、计量和报告，不得提前或延后",
                "difficulty": "2",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "title": "会计要素与会计等式",
