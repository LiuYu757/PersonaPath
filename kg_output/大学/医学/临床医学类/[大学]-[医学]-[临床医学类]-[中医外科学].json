                "children": []
              },
              {
                "title": "外痔",
                "content": "位于齿线以下，分炎性、血栓性、结缔组织性、静脉曲张性四类",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "混合痔",
                "content": "内痔与外痔相互沟通吻合形成，兼具两者症状",
                "difficulty": "3",
                "children": []
              }
            ]
          },
          {
            "title": "肛痈",
            "content": "肛管直肠周围间隙急性化脓性感染，表现为红肿热痛，破溃后多形成肛漏",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "肛漏",
            "content": "直肠与肛门皮肤间异常通道，由肛痈溃后余毒未尽而成，分单纯性与复杂性",
            "difficulty": "4",
            "children": []
          },
          {
            "title": "肛裂",
            "content": "肛管皮肤全层裂开形成感染性溃疡，好发于6、12点，典型症状为周期性疼痛、出血、便秘",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "脱肛",
            "content": "直肠黏膜或全层向下移位，分Ⅰ-Ⅲ度，儿童多可自愈，成人需手术",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "息肉痔",
            "content": "结直肠黏膜赘生物，可单发或多发，部分可恶变，需病理确诊",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "锁肛痔",
            "content": "肛管直肠癌晚期，肿瘤阻塞致排便困难，似肛门被锁，需根治手术",
            "difficulty": "5",
            "children": []
          }
        ]
      },
      {
        "title": "泌尿男性生殖系疾病",
        "content": "包括子痈、囊痈、子痰、阴茎痰核、水疝、尿石症、男性不育、阳痿、血精、精浊、精癃、前列腺癌等",
        "difficulty": "4",
        "children": [
          {
            "title": "子痈",
            "content": "睾丸及附睾化脓性疾病，分急性与慢性，相当于急慢性附睾睾丸炎",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "囊痈",
            "content": "阴囊急性化脓性炎症，红肿热痛，相当于阴囊蜂窝织炎",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "子痰",
            "content": "附睾结核，硬结渐大，成脓溃破后脓液稀薄如痰，易成窦道",
            "difficulty": "4",
            "children": []
          },
          {
            "title": "阴茎痰核",
            "content": "阴茎海绵体白膜纤维化硬结，勃起时弯曲疼痛，相当于阴茎硬结症",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "水疝",
            "content": "睾丸或精索鞘膜积液，阴囊肿大如水晶，透光试验阳性",
            "difficulty": "2",
            "children": []
          },
          {
            "title": "尿石症",
            "content": "泌尿系结石，典型表现为腰腹部绞痛与血尿，分上尿路结石与下尿路结石",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "男性不育症",
            "content": "育龄夫妇同居一年以上未避孕未育，因男方因素所致，与肾精亏虚、肝郁、湿热、气血两虚相关",
            "difficulty": "4",
            "children": []
          },
          {
            "title": "阳痿",
            "content": "阴茎不能勃起或勃起不坚，不能完成性交，与肝郁、湿热、脾虚、血瘀、心脾两虚、惊恐、肾阴阳亏虚相关",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "血精",
            "content": "精液中夹血，色红或暗，多因湿热下注、阴虚火旺、瘀血阻络、脾肾两虚所致",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "精浊",
            "content": "慢性前列腺炎，以尿频、尿急、尿痛、尿道滴白、会阴不适为主症，分湿热、气滞血瘀、阴虚火旺、肾阳虚损证",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "精癃",
            "content": "良性前列腺增生，以尿频、夜尿增多、排尿困难为主，严重者可尿潴留",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "前列腺癌",
            "content": "老年男性常见恶性肿瘤，早期无症状，晚期可出现排尿困难、骨痛，需前列腺穿刺确诊",
            "difficulty": "5",
            "children": []
          }
        ]
      },
      {
        "title": "周围血管疾病",
        "content": "包括臁疮、青蛇毒、股肿、脱疽、淋巴水肿等，以血瘀为基本病机",
        "difficulty": "4",
        "children": [
          {
            "title": "臁疮",
            "content": "小腿下1/3慢性溃疡，经久难愈，常继发于下肢静脉曲张，与湿热下注、气虚血瘀相关",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "青蛇毒",
            "content": "血栓性浅静脉炎，沿浅静脉走行出现条索状红肿疼痛，色赤如蚯蚓",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "股肿",
            "content": "下肢深静脉血栓形成，表现为肢体肿胀、疼痛、皮温升高、浅静脉怒张，可并发肺栓塞",
            "difficulty": "4",
            "children": []
          },
          {
            "title": "脱疽",
            "content": "四肢末端坏疽脱落，包括血栓闭塞性脉管炎、动脉硬化闭塞症、糖尿病足，分寒湿阻络、血脉瘀阻、湿热毒盛、热毒伤阴、气阴两虚证",
            "difficulty": "5",
            "children": []
          },
          {
            "title": "淋巴水肿",
            "content": "淋巴回流障碍致肢体肿胀，后期皮肤增厚粗糙如象皮，称“象皮肿”",
            "difficulty": "3",
            "children": []
          }
        ]
      },
      {
        "title": "其他外科疾病",
        "content": "包括冻疮、烧伤、毒蛇咬伤、破伤风、肠痈、胆石症、痛风等",
        "difficulty": "3",
        "children": [
          {
            "title": "冻疮",
            "content": "寒冷致局部或全身性损伤，局部性分Ⅰ-Ⅳ度，全身性可致阳气厥脱",
            "difficulty": "2",
            "children": []
          },
          {
            "title": "烧伤",
            "content": "热力等致急性损伤，分Ⅰ°、浅Ⅱ°、深Ⅱ°、Ⅲ°，面积用九分法或手掌法计算",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "毒蛇咬伤",
            "content": "分神经毒、血循毒、混合毒，需早期结扎、扩创排毒、辨证解毒",
            "difficulty": "4",
            "children": []
          },
          {
            "title": "破伤风",
            "content": "皮肉破伤风毒侵入，以肌肉强直性痉挛和阵发性抽搐为特征，潜伏期4-14天",
            "difficulty": "4",
            "children": []
          },
          {
            "title": "肠痈",
            "content": "急性阑尾炎，典型转移性右下腹痛，分瘀滞、湿热、热毒证，可中西医结合治疗",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "胆石症",
            "content": "湿热浊毒与胆汁互结成石，阻塞胆道，分肝郁气滞、肝胆湿热、肝胆脓毒、肝阴不足证",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "痛风",
            "content": "嘌呤代谢障碍致高尿酸血症，急性关节炎反复发作，分湿热阻痹、风寒湿痹、痰瘀阻滞、肝肾阴虚证",
            "difficulty": "3",
            "children": []
          }
        ]
      }
    ]
  },
