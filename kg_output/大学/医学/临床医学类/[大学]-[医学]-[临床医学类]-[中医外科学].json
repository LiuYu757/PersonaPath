      },
      {
        "title": "皮肤病",
        "content": "包括白疕、风热疮、紫癜风、白驳风、黧黑斑、粉刺、白屑风、酒齄鼻、油风、红蝴蝶疮等常见皮肤病的辨证论治",
        "difficulty": "3",
        "children": [
          {
            "title": "白疕（银屑病）",
            "content": "以红斑、鳞屑、薄膜现象、点状出血为特征的慢性炎症性皮肤病，分寻常型、脓疱型、关节病型、红皮病型",
            "difficulty": "3",
            "children": [
              {
                "title": "寻常型白疕",
                "content": "占99%，皮损为淡红或鲜红色丘疹或斑丘疹，表面覆银白色鳞屑，刮除后见薄膜现象及点状出血",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "脓疱型白疕",
                "content": "分泛发性与局限性，在红斑基础上出现密集小脓疱，可融合成“脓湖”，伴高热、关节痛",
                "difficulty": "4",
                "children": []
              },
              {
                "title": "关节病型白疕",
                "content": "伴远端指趾关节不对称关节炎，关节红肿疼痛，可强直畸形",
                "difficulty": "4",
                "children": []
              },
              {
                "title": "红皮病型白疕",
                "content": "全身皮肤弥漫性潮红肿胀，大量糠状脱屑，伴发热、淋巴结肿大",
                "difficulty": "5",
                "children": []
              }
            ]
          },
          {
            "title": "风热疮（玫瑰糠疹）",
            "content": "急性自限性皮肤病，初发母斑为玫瑰色椭圆形红斑，长轴与皮纹一致，后分批出现子斑",
            "difficulty": "2",
            "children": []
          },
          {
            "title": "紫癜风（扁平苔藓）",
            "content": "紫红色多角形扁平丘疹，表面蜡样光泽，可见Wickham纹，常伴黏膜损害",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "白驳风（白癜风）",
            "content": "后天性限局性色素脱失斑，边界清楚，周边色素加深，可发生于任何部位",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "黧黑斑（黄褐斑）",
            "content": "面部对称性褐色斑片，边界清楚，无自觉症状，日晒后加重，与肝脾肾三脏失调相关",
            "difficulty": "2",
            "children": []
          },
          {
            "title": "粉刺（痤疮）",
            "content": "毛囊皮脂腺慢性炎症，好发于颜面、胸背，皮损为丘疹、脓疱、结节、囊肿，伴皮脂溢出",
            "difficulty": "2",
            "children": []
          },
          {
            "title": "白屑风（脂溢性皮炎）",
            "content": "头皮油腻脱屑或干燥飞屑，伴瘙痒，可脱发，与湿热上蒸或风热血燥相关",
            "difficulty": "2",
            "children": []
          },
          {
            "title": "酒齄鼻（玫瑰痤疮）",
            "content": "鼻及面中部持续性红斑、毛细血管扩张，分红斑型、丘疹脓疱型、鼻赘型",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "油风（斑秃）",
            "content": "突然发生斑片状脱发，脱发区皮肤光滑，边界清楚，可自愈或复发",
            "difficulty": "2",
            "children": []
          },
          {
            "title": "红蝴蝶疮（红斑狼疮）",
            "content": "分盘状与系统性，典型皮损为蝶形水肿性红斑，系统型可累及多脏器",
            "difficulty": "5",
            "children": []
          }
        ]
      },
      {
        "title": "肛肠疾病",
        "content": "包括痔、肛痈、肛漏、肛裂、脱肛、息肉痔、锁肛痔等肛门直肠疾病的辨证与手术疗法",
