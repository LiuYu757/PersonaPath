{
  "knowledge_tree": {
    "title": "音乐与舞蹈",
    "content": "高中音乐与舞蹈课程，涵盖舞蹈起源、种类、中外民族民间舞、古典舞、芭蕾舞、现代舞及社交舞等内容",
    "difficulty": "2",
    "children": [
      {
        "title": "舞蹈的起源",
        "content": "舞蹈起源于人类生产劳动、战斗操练、社会生活，以及图腾崇拜、巫术、宗教祭礼等活动",
        "difficulty": "1",
        "children": [
          {
            "title": "远古时期的舞蹈",
            "content": "在远古时代，诗歌、音乐、舞蹈原是一个艺术整体",
            "difficulty": "1",
            "children": []
          },
          {
            "title": "舞蹈与音乐的关系",
            "content": "音乐展开的过程也是舞蹈情绪或舞蹈剧情展开的过程",
            "difficulty": "2",
            "children": []
          }
        ]
      },
      {
        "title": "舞蹈的种类",
        "content": "根据舞蹈的作用和目的，可分为生活舞蹈和艺术舞蹈两大类",
        "difficulty": "1",
        "children": [
          {
            "title": "生活舞蹈",
            "content": "人们为自己的生活需要而进行的舞蹈活动",
            "difficulty": "1",
            "children": [
              {
                "title": "习俗舞蹈",
                "content": "又称节庆、仪式舞蹈，是许多民族在婚配、丧葬、种植、收获等喜庆节日举行的群众性舞蹈活动",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "宗教祭祀舞蹈",
                "content": "进行宗教祭祀的舞蹈活动，用以表示对先祖的怀念",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "自娱舞蹈",
                "content": "人们以自娱自乐为目的的舞蹈活动",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "社交舞蹈",
                "content": "人们进行社会交往、增进友谊、联络感情的舞蹈活动",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "教育舞蹈",
                "content": "幼儿园、学校等进行审美教育的舞蹈活动",
                "difficulty": "1",
                "children": []
              }
            ]
          },
          {
            "title": "艺术舞蹈",
            "content": "按风格特点可划分为古典舞、民间舞、现代舞等",
            "difficulty": "1",
            "children": [
              {
                "title": "古典舞",
                "content": "有独特风格特征的表演性舞蹈种类，专指各民族中长期流传的具有典范意义的优秀舞蹈作品",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "民间舞",
                "content": "由广大人民群众在长期历史进程中集体创造，不断积累发展而成，并在群众中广泛流传的舞蹈",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "现代舞",
                "content": "19世纪末20世纪初在欧美兴起的一种舞蹈种类，主张摆脱古典芭蕾束缚，自由抒发真实情感",
                "difficulty": "2",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "title": "中国汉族民间舞",
        "content": "中国汉族民间舞蹈种类繁多，风格各异，主要有北方秧歌和南方花灯等",
        "difficulty": "2",
        "children": [
          {
            "title": "山东鼓子秧歌",
            "content": "流传于鲁北地区的广场性民间舞蹈，形成粗犷雄厚、气势豪迈的风格特点",
            "difficulty": "3",
            "children": [
              {
                "title": "持鼓基本手形",
                "content": "山东鼓子秧歌特有的持鼓手法",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "动作组合",
                "content": "包括直立抻鼓子、大蹲裆部抻鼓子、海底捞月等典型动作",
                "difficulty": "3",
                "children": []
              }
            ]
          },
          {
            "title": "云南花灯",
            "content": "云南省的汉族民间歌舞，以优美轻盈著称",
            "difficulty": "3",
            "children": [
              {
                "title": "基本手形",
                "content": "持巾、花指握扇、握扇、花指夹扇等",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "动作组合",
                "content": "包括小崴正步位、吸腿叉腰小崴跳颠步、撩腿正崴跳颠步等",
                "difficulty": "3",
                "children": []
              }
            ]
          },
          {
            "title": "秧歌",
            "content": "汉族民间舞蹈形式，起源于农民祈祷丰收的祭祀仪式与农耕劳动生活",
            "difficulty": "2",
            "children": []
          },
          {
            "title": "道具的作用",
            "content": "道具在中国传统民族民间舞蹈中起到丰富艺术语汇、增强表现力的作用",
            "difficulty": "2",
            "children": []
          }
        ]
      },
      {
        "title": "中国少数民族舞",
        "content": "中国少数民族舞具有鲜明的民族性和地域性，形式多样，风格独特",
        "difficulty": "2",
        "children": [
          {
            "title": "蒙古族舞蹈",
            "content": "形成肩部松弛、臂部强劲、手腕灵活的风格特征，具有松弛自如、粗犷豪放的特点",
            "difficulty": "3",
            "children": [
              {
                "title": "基本手形",
                "content": "平手（四指并拢，拇指自然旁开）",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "动作组合",
                "content": "包括提压腕、鹰式平开手位提压腕、蹉步鹰式平开手位提压腕等",
                "difficulty": "3",
                "children": []
              }
            ]
          },
          {
            "title": "藏族舞蹈",
            "content": "形式种类繁多，风格多样，可分为民间自娱性舞蹈和宗教舞蹈两大类",
            "difficulty": "3",
            "children": [
              {
                "title": "基本手形",
                "content": "平手（四指并拢，拇指自然旁开）",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "动作组合",
                "content": "包括原地颤膝、行进碎踏步、退踏步、嘀嗒步、第一基本步等",
                "difficulty": "3",
                "children": []
              }
            ]
          },
          {
            "title": "维吾尔族舞蹈",
            "content": "舞蹈和民间音乐结合紧密，形成热情、豪放、稳重、细腻的风格",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "朝鲜族舞蹈",
            "content": "具有仙鹤般优美的舞姿和飘逸的神韵，动作潇洒典雅、柔中带韧",
            "difficulty": "3",
            "children": []
          }
        ]
      },
      {
        "title": "中国古典舞",
        "content": "当代中国古典舞继承戏曲、武术等传统文化精粹，凝聚中国传统审美特质",
        "difficulty": "3",
        "children": [
          {
            "title": "基本手形",
            "content": "掌、提襟、兰花手等",
            "difficulty": "2",
            "children": []
          },
          {
            "title": "男生动作组合",
            "content": "包括丁字步子午相叉腰、双展翅、双盖手、山膀提襟等",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "女生动作组合",
            "content": "包括八字步基本位、提气起手、沉气落手、大掖步顺风旗等",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "发展历程",
            "content": "当代中国古典舞是今人对中国传统古典舞的复兴与再造，始于20世纪50年代",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "表演基础能力",
            "content": "包括丰富的舞蹈表情能力、舞蹈文化素养、文学艺术修养和生活知识积累",
            "difficulty": "3",
            "children": []
          }
        ]
      },
      {
        "title": "芭蕾舞",
        "content": "以欧洲古典舞蹈为主要表现手段，综合音乐、戏剧、舞台美术等形式的舞蹈艺术",
        "difficulty": "3",
        "children": [
          {
            "title": "审美原则",
            "content": "开、绷、直、立四大审美原则",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "基本动作",
            "content": "包括脚的基本位置、手的基本位置、基本舞姿等",
            "difficulty": "3",
            "children": [
              {
                "title": "脚的基本位置",
                "content": "一位、二位、三位、四位、五位",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "手的基本位置",
                "content": "一位至七位手位",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "基本舞姿",
                "content": "包括阿拉贝斯等典型舞姿",
                "difficulty": "3",
                "children": []
              }
            ]
          },
          {
            "title": "动作组合",
            "content": "包括各种手位组合、舞姿组合等",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "浪漫芭蕾",
            "content": "芭蕾史上的第二个阶段，起源于18世纪末19世纪初的巴黎",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "剧场礼仪",
            "content": "芭蕾剧场有约定俗成的鼓掌时刻和观赏礼仪",
            "difficulty": "2",
            "children": []
          }
        ]
      },
      {
        "title": "外国民族民间舞",
        "content": "外国民族民间舞蹈种类繁多，风格各异，主要有俄罗斯舞蹈、印度舞蹈、非洲舞蹈等",
        "difficulty": "3",
        "children": [
          {
            "title": "俄罗斯舞蹈",
            "content": "主要有轮舞、竞演舞和卡德里尔舞等形式",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "印度舞蹈",
            "content": "具有背部曲直变化、膝部外开弯曲、手势千变万化和面部表情丰富灵动等特征",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "非洲舞蹈",
            "content": "节奏强烈，强调人体各部位的表现力，以鼓为主的打击乐器是舞蹈音乐的灵魂",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "踢踏舞",
            "content": "以脚下动作为主的舞蹈形式",
            "difficulty": "3",
            "children": [
              {
                "title": "动作组合",
                "content": "包括踏步行走、踢踏追步、足尖踢踏单脚跳等",
                "difficulty": "3",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "title": "现代舞",
        "content": "起源于19世纪末20世纪初的美国和德国，主张摆脱古典芭蕾束缚，自由抒发真实情感",
        "difficulty": "3",
        "children": [
          {
            "title": "历史发展阶段",
            "content": "分为肇始时期、奠基时期和发展时期三个阶段",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "音乐特点",
            "content": "现代舞的音乐多样，有时仅用作动作的对位背景或节奏标记",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "动作组合",
            "content": "包括各种现代舞基本动作和组合",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "中国现代舞先驱",
            "content": "吴晓邦是当代中国新舞蹈艺术的先驱",
            "difficulty": "2",
            "children": []
          },
          {
            "title": "欣赏建议",
            "content": "欣赏现代舞需要开放的心态，超越'赏心悦目'的期待，建立学习和探索的习惯",
            "difficulty": "2",
            "children": []
          }
        ]
      },
      {
        "title": "社交舞",
        "content": "主要用于维系和增强人际关系，具有社会交往功能的舞蹈样式",
        "difficulty": "2",
        "children": [
          {
            "title": "起源",
            "content": "起源于意大利文艺复兴时期，14世纪发展为具有社交和礼仪性质的宫廷舞蹈",
            "difficulty": "2",
            "children": []
          },
          {
            "title": "用途",
            "content": "用于舞会、宴会和娱乐晚会，是一种自娱性的舞蹈",
            "difficulty": "1",
            "children": []
          },
          {
            "title": "服装要求",
            "content": "男士一般穿单色西服或马甲，女士穿连衣裙或大摆裙，需要舒适的舞鞋",
            "difficulty": "1",
            "children": []
          },
          {
            "title": "华尔兹",
            "content": "社交舞的一种，节奏轻快，旋律优美",
            "difficulty": "2",
            "children": [
              {
                "title": "双人搭持手形及手位",
                "content": "包括邀请位、握持位、前搭持位等",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "动作组合",
                "content": "包括左方形步、右方形步、左转方形步等",
                "difficulty": "3",
                "children": []
              }
            ]
          },
          {
            "title": "国标舞",
            "content": "国际标准交谊舞，分为摩登舞和拉丁舞两大类，共十个舞种",
