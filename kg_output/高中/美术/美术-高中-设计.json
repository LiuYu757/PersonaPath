{
  "knowledge_tree": {
    "title": "高中美术设计",
    "content": "普通高中美术选择性必修4设计课程，涵盖设计概述、视觉传达设计、产品设计、环境设计及设计价值创造等内容",
    "difficulty": "2",
    "children": [
      {
        "title": "设计概述",
        "content": "设计的基本概念、发展历程及社会价值",
        "difficulty": "1",
        "children": [
          {
            "title": "设计的定义",
            "content": "源于拉丁文Designave，指徽章、记号，中国古称造物，是以人工改变物质形态及价值的创造行为",
            "difficulty": "1",
            "children": []
          },
          {
            "title": "设计的目的",
            "content": "满足人的需求，包括生理、安全、爱、尊重及自我实现五个层次",
            "difficulty": "1",
            "children": []
          },
          {
            "title": "设计与社会",
            "content": "设计是连接人、自然、社会、技术的媒介，影响生活方方面面",
            "difficulty": "2",
            "children": []
          }
        ]
      },
      {
        "title": "视觉传达设计",
        "content": "通过视觉媒介传递信息的设计领域，包括图形、文字、信息视觉化及包装设计",
        "difficulty": "2",
        "children": [
          {
            "title": "图形设计",
            "content": "图形是用轮廓划分出的空间形状，图标是指代意义的标识图形",
            "difficulty": "1",
            "children": [
              {
                "title": "图形设计方法",
                "content": "包括同构图形、无理图形、共生图形、正负图形、异影图形、异变图形等",
                "difficulty": "3",
                "children": []
              },
              {
                "title": "图标与功能",
                "content": "图标应清晰传达属性和功能，如导视设计需易读易懂",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "图标与文化",
                "content": "图标可体现地域文化与精神，如2008北京奥运会图标融合篆字结构",
                "difficulty": "2",
                "children": []
              }
            ]
          },
          {
            "title": "字体设计",
            "content": "印刷字与美术字的区别，字体结构及笔形设计",
            "difficulty": "2",
            "children": [
              {
                "title": "字体结构",
                "content": "汉字结构分方形、圆形、菱形、三角形，中宫和重心影响字体平衡",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "笔形设计",
                "content": "笔形即笔画形状，通过形态造型、共用笔形、肌理质感、形象叠加、改变外形、添加装饰等方法设计",
                "difficulty": "3",
                "children": []
              },
              {
                "title": "字体海报",
                "content": "字体可作为海报主体，结合动态效果增强感染力",
                "difficulty": "3",
                "children": []
              }
            ]
          },
          {
            "title": "信息视觉化",
            "content": "将复杂信息通过图形化手段变得易读易懂",
            "difficulty": "2",
            "children": [
              {
                "title": "信息整理归纳",
                "content": "如伦敦地铁线路图简化实际距离，突出站点信息",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "图形化方法",
                "content": "借鉴伊索体系，用图形语言展示信息",
                "difficulty": "3",
                "children": []
              },
              {
                "title": "视觉化表现",
                "content": "造型简化、有限颜色、平面化、明确数量表达等",
                "difficulty": "3",
                "children": []
              }
            ]
          },
          {
            "title": "包装设计",
            "content": "包装的功能、结构与品牌价值体现",
            "difficulty": "2",
            "children": [
              {
                "title": "包装功能",
                "content": "保护盛载、储运促销、美化传达、环保卫生、循环再生",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "包装与品牌",
                "content": "包装需体现产品品牌价值和情感，提升影响力",
                "difficulty": "3",
                "children": []
              },
              {
                "title": "绿色设计",
                "content": "考虑环境、生态与可持续发展，如使用可降解材料",
                "difficulty": "3",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "title": "产品设计",
        "content": "处理功能与审美关系，通过改良创新满足受众需求",
        "difficulty": "2",
        "children": [
          {
            "title": "功能与审美",
            "content": "产品需合理功能与赏心悦目造型材质结合",
            "difficulty": "2",
            "children": [
              {
                "title": "功能合理性",
                "content": "如饮水容器的抓握防烫、保温防尘、使用功能差异",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "审美表现",
                "content": "造型美、材质美、工艺美营造产品多样性",
                "difficulty": "2",
                "children": []
              }
            ]
          },
          {
            "title": "改良与创新",
            "content": "科技、需求、审美、经济推动产品发展",
            "difficulty": "3",
            "children": [
              {
                "title": "科技进步",
                "content": "原理更新、创新材料与加工工艺推动产品演变",
                "difficulty": "3",
                "children": []
              },
              {
                "title": "需求与风格",
                "content": "完善需求与追逐时尚促成产品多样化",
                "difficulty": "3",
                "children": []
              },
              {
                "title": "经济因素",
                "content": "设计提升性价比与附加值，追求经济效益",
                "difficulty": "3",
                "children": []
              }
            ]
          },
          {
            "title": "需求与服务",
            "content": "设计考虑大众需求差异化与多样性",
            "difficulty": "2",
            "children": [
              {
                "title": "需求差异化",
                "content": "如多用鞋适应不同人群，椅子体现行为差异，餐具反映文化差异",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "需求多样性",
                "content": "同消费者随年龄、季节、情绪、审美变化需求调整，如衣柜、灯具、童车、适老设计",
                "difficulty": "2",
                "children": []
              }
            ]
          },
          {
            "title": "程序与方法",
            "content": "服装设计的严谨过程与科学方法",
            "difficulty": "3",
            "children": [
              {
                "title": "设计过程",
                "content": "从调研到样衣的步骤：资料收集、市场调研、灵感来源、头脑风暴、概念版、元素提取、设计草图、效果图、打版制作、样衣调整等",
                "difficulty": "3",
                "children": []
              },
              {
                "title": "设计方法",
                "content": "灵感捕捉、设计表达、色彩应用、面料再造、制版方法等",
                "difficulty": "4",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "title": "环境设计",
        "content": "源于自然高于自然，涵盖建筑、景观、室内设计",
        "difficulty": "2",
        "children": [
          {
            "title": "建筑形式",
            "content": "科技与文化决定建筑形式，如地域气候影响",
            "difficulty": "2",
            "children": [
              {
                "title": "决定因素",
                "content": "地理、气候、资源、科技造成建筑多样性，如吊脚楼、窑洞、骑楼",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "文化影响",
                "content": "如客厅布局反映待客习惯与道德观，中西日差异显著",
                "difficulty": "2",
                "children": []
              }
            ]
          },
          {
            "title": "环境景观",
            "content": "道路、植物、水景等元素塑造景观",
            "difficulty": "2",
            "children": [
              {
                "title": "景观元素",
                "content": "道路形式材料、植物组合、水景形式、景观小品",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "设计步骤",
                "content": "确定边界、道路组织、设置主景观、布置植被、安置设施",
                "difficulty": "3",
                "children": []
              }
            ]
          },
          {
            "title": "室内空间",
            "content": "尺度、形状、材料构架室内物理属性",
            "difficulty": "2",
            "children": [
              {
                "title": "尺度与形状",
                "content": "房间尺寸基于功能需求，形状影响效果，特殊形状如天坛圆形、万神庙球形",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "材料选择",
                "content": "材料特性对应使用诉求，影响心理感受，如木温暖、石冷静",
                "difficulty": "2",
                "children": []
              }
            ]
          },
          {
            "title": "室内气氛",
            "content": "光影与色彩营造室内气氛",
            "difficulty": "2",
            "children": [
              {
                "title": "色彩应用",
                "content": "色彩表达情感，组合可用对比色、互补色、类似色、邻近色等",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "光的设计",
                "content": "自然采光与人工光满足功能与美学需求，窗口位置、大小、形状创造不同光效",
                "difficulty": "3",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "title": "创造价值服务人民",
        "content": "设计价值体现在服务大众、社会，包括商业、文化、人本、可持续价值",
        "difficulty": "2",
        "children": [
          {
            "title": "提升商业价值",
            "content": "设计被市场认可才有价值，市场研究与定位是关键",
            "difficulty": "3",
            "children": [
              {
                "title": "成功案例",
                "content": "如智能手机、Paimio椅、和谐号动车",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "市场研究",
                "content": "情感化设计、SWOT分析、知觉地图等方法",
                "difficulty": "3",
                "children": []
              },
              {
                "title": "开发战略",
                "content": "清晰战略促成商业利益最大化",
                "difficulty": "3",
                "children": []
              }
            ]
          },
          {
            "title": "传播国家形象",
            "content": "通过国际平台如奥运会展现国家文化",
            "difficulty": "2",
            "children": [
              {
                "title": "文化表现",
                "content": "如2008北京奥运会会徽、奖牌、火炬融入中国元素",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "商业价值",
                "content": "吉祥物、队服等衍生商品产生经济效益",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "文化价值",
                "content": "奥运理念、开闭幕式、场馆利用体现文化技术价值",
                "difficulty": "2",
                "children": []
              }
            ]
          },
          {
            "title": "弘扬传统文化",
            "content": "设计继承创新传统文化，体现文化价值",
            "difficulty": "2",
            "children": [
              {
                "title": "文化价值",
                "content": "如椅君子、靳埭强海报、梁思成建筑研究",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "创新价值",
                "content": "如辰山植物园、年画创新、王澍建筑",
                "difficulty": "3",
                "children": []
              }
            ]
          },
          {
            "title": "回归以人为本",
            "content": "设计的社会、地区、人本关怀",
            "difficulty": "2",
            "children": [
              {
                "title": "社会关怀",
                "content": "如微杂院改造、社区微更新",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "地区关怀",
                "content": "如福建上坪古村振兴、玉树服务中心",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "人本关怀",
                "content": "服务设计关注触点体验，如智能勺子、Braille字体",
                "difficulty": "3",
                "children": []
              }
            ]
          },
          {
            "title": "推广可持续理念",
            "content": "设计兼顾经济与社会价值，倡导可持续发展",
            "difficulty": "2",
            "children": [
              {
                "title": "社会使命",
                "content": "设计师需有使命感，避免过度消费与资源浪费",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "可持续发展",
                "content": "绿色城市、新能源、垃圾分类、循环利用",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "变废为宝",
                "content": "旧物再利用实践，如泡沫网杯垫制作",
                "difficulty": "2",
                "children": []
              }
            ]
          }
        ]
      }
    ]
  },
