                  },
                  {
                    "title": "键长",
                    "content": "形成化学键的两个原子核间的平衡距离",
                    "difficulty": "3",
                    "children": []
                  },
                  {
                    "title": "键角",
                    "content": "分子中相邻共价键之间的夹角",
                    "difficulty": "3",
