              {
                "title": "σ键",
                "content": "头碰头重叠形成的共价键，具有轴对称性",
                "difficulty": "3",
                "children": []
              },
              {
                "title": "π键",
                "content": "肩并肩重叠形成的共价键，具有镜面对称性",
                "difficulty": "4",
                "children": []
              },
              {
