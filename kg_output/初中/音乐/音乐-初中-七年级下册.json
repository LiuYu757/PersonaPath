{
  "knowledge_tree": {
    "title": "七年级下册音乐",
    "content": "本册教材围绕声音的科学属性、音乐的艺术表现、欣赏方法与表演创作展开，涵盖声学基础、音乐表现要素、联觉现象、复调音乐、记谱法与二度创作等内容",
    "difficulty": "2",
    "children": [
      {
        "title": "声音的产生与属性",
        "content": "声音由物体振动产生，通过空气传播至人耳，具有四种基本属性",
        "difficulty": "1",
        "children": [
          {
            "title": "振动与声波",
            "content": "物体振动推动空气密度变化形成声波，通过鼓膜振动产生听觉",
            "difficulty": "1",
            "children": []
          },
          {
            "title": "声音四属性",
            "content": "频率（音高）、幅度（音强）、时间（音长）、波形（音色）",
            "difficulty": "1",
            "children": [
              {
                "title": "音高",
                "content": "由振动频率决定，频率高则音高，频率低则音低",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "音强",
                "content": "由振动幅度决定，幅度大则音强，幅度小则音弱",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "音长",
                "content": "由振动时间决定，时间长则音长，时间短则音短",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "音色",
                "content": "由振动波形决定，不同发声体产生不同音色",
                "difficulty": "2",
                "children": []
              }
            ]
          },
          {
            "title": "声音过程",
            "content": "包含起音(attack)、持续(sustain)、衰减(decay)、消逝(release)四个阶段",
            "difficulty": "2",
            "children": [
              {
                "title": "音头",
                "content": "声音起始部分，起音速度影响声音硬度",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "音腹",
                "content": "声音持续部分，决定声音的稳定性",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "音尾",
                "content": "声音结束部分，影响声音的韵味",
                "difficulty": "2",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "title": "建筑声学基础",
        "content": "研究声音在建筑环境中的传播与处理",
        "difficulty": "3",
        "children": [
          {
            "title": "直达声",
            "content": "从声源直接到达听者耳朵的声音",
            "difficulty": "2",
            "children": []
          },
          {
            "title": "反射声",
            "content": "声音遇到硬质界面反射后到达听者",
            "difficulty": "2",
            "children": []
          },
          {
            "title": "混响",
            "content": "声源停止后声音在空间内持续的现象",
            "difficulty": "3",
            "children": []
          },
          {
            "title": "混响时间",
            "content": "声源停止后声音衰减60dB所需时间",
            "difficulty": "3",
            "children": []
          }
        ]
      },
