                "children": []
              },
              {
                "title": "Letter Rr",
                "content": "Sound /r/ as in red, ruler.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Letter Ss",
                "content": "Sound /s/ as in see, bus.",
                "difficulty": "1",
