{
  "knowledge_tree": {
    "title": "PEP English Grade 3 Book 1",
    "content": "English textbook for Grade 3, Semester 1, covering topics like making friends, families, animals, plants, colours, and numbers.",
    "difficulty": "1",
    "children": [
      {
        "title": "Unit 1: Making friends",
        "content": "Learning how to greet, introduce, and be a good friend.",
        "difficulty": "1",
        "children": [
          {
            "title": "Greeting friends",
            "content": "Learn to greet and introduce each other with gestures.",
            "difficulty": "1",
            "children": [
              {
                "title": "Basic greetings",
                "content": "Hello, Hi, What's your name?, My name is..., Nice to meet you.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Gestures for greeting",
                "content": "Wave hand, look into eyes, shake hands.",
                "difficulty": "1",
                "children": []
              }
            ]
          },
          {
            "title": "Being a good friend",
            "content": "Learn action verbs and behaviors for showing friendliness.",
            "difficulty": "1",
            "children": [
              {
                "title": "Action verbs",
                "content": "Listen, smile, help, share, play fair.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Examples of friendliness",
                "content": "I listen with care, I say Hi and Goodbye, I share my toys, I help my friends.",
                "difficulty": "1",
                "children": []
              }
            ]
          },
          {
            "title": "Phonics: Letters Aa-Dd",
            "content": "Learn the sounds and writing of letters Aa, Bb, Cc, Dd.",
            "difficulty": "1",
            "children": [
              {
                "title": "Letter Aa",
                "content": "Sound /æ/ as in apple, bag.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Letter Bb",
                "content": "Sound /b/ as in bed, Bob.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Letter Cc",
                "content": "Sound /k/ as in cat, can.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Letter Dd",
                "content": "Sound /d/ as in dog, sad.",
                "difficulty": "1",
                "children": []
              }
            ]
          },
          {
            "title": "Grammar: Simple present",
            "content": "Learn to use simple present tense for self-introduction and actions.",
            "difficulty": "2",
            "children": [
              {
                "title": "Self-introduction",
                "content": "I'm Mike Black. My name is Wu Binbin.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Describing actions",
                "content": "I smile. I help.",
                "difficulty": "1",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "title": "Unit 2: Different families",
        "content": "Learning about family members and how to introduce them.",
        "difficulty": "1",
        "children": [
          {
            "title": "Family members",
            "content": "Learn vocabulary for family members.",
            "difficulty": "1",
            "children": [
              {
                "title": "Immediate family",
                "content": "mother (mum), father (dad), sister, brother, me.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Extended family",
                "content": "grandmother (grandma), grandfather (grandpa), aunt, uncle, cousin, baby sister.",
                "difficulty": "1",
                "children": []
              }
            ]
          },
          {
            "title": "Introducing family",
            "content": "Learn to introduce family members to others.",
            "difficulty": "1",
            "children": [
              {
                "title": "This is... structure",
                "content": "This is my grandma. This is my friend, Sarah.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Asking about family",
                "content": "Is this your sister? Is that your brother?",
                "difficulty": "1",
                "children": []
              }
            ]
          },
          {
            "title": "Phonics: Letters Ee-Hh",
            "content": "Learn the sounds and writing of letters Ee, Ff, Gg, Hh.",
            "difficulty": "1",
            "children": [
              {
                "title": "Letter Ee",
                "content": "Sound /e/ as in egg, nest.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Letter Ff",
                "content": "Sound /f/ as in fish, beef.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Letter Gg",
                "content": "Sound /g/ as in girl, pig.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Letter Hh",
                "content": "Sound /h/ as in hot, hat.",
                "difficulty": "1",
                "children": []
              }
            ]
          },
          {
            "title": "Grammar: Demonstratives",
            "content": "Learn to use this, that, these, those for pointing out people and things.",
            "difficulty": "2",
            "children": [
              {
                "title": "This and that",
                "content": "This is my grandma. Is that your brother?",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Yes/No questions",
                "content": "Is this your sister? Yes, it is. No, it's my cousin.",
                "difficulty": "1",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "title": "Unit 3: Amazing animals",
        "content": "Learning about pets and wild animals, and how to describe them.",
        "difficulty": "1",
        "children": [
          {
            "title": "Pets",
            "content": "Learn common pets and how to talk about them.",
            "difficulty": "1",
            "children": [
              {
                "title": "Pet vocabulary",
                "content": "dog, cat, fish, bird, rabbit.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Asking about pets",
                "content": "Do you have a pet? Yes, I do. / No, I don't.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Expressing likes",
                "content": "I like cats. I like birds.",
                "difficulty": "1",
                "children": []
              }
            ]
          },
          {
            "title": "Wild animals",
            "content": "Learn common wild animals and how to identify them.",
            "difficulty": "1",
            "children": [
              {
                "title": "Wild animal vocabulary",
                "content": "fox, red panda, monkey, tiger, elephant, lion, giraffe.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Asking about animals",
                "content": "What's this? What's that? It's a fox.",
                "difficulty": "1",
                "children": []
              }
            ]
          },
          {
            "title": "Phonics: Letters Ii-Ll",
            "content": "Learn the sounds and writing of letters Ii, Jj, Kk, Ll.",
            "difficulty": "1",
            "children": [
              {
                "title": "Letter Ii",
                "content": "Sound /ɪ/ as in ill, kid.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Letter Jj",
                "content": "Sound /ʤ/ as in job, jet.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Letter Kk",
                "content": "Sound /k/ as in Kim, kite.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Letter Ll",
                "content": "Sound /l/ as in leg, lion.",
                "difficulty": "1",
                "children": []
              }
            ]
          },
          {
            "title": "Grammar: Nouns and simple present",
            "content": "Learn to use nouns for animals and simple present for likes and questions.",
            "difficulty": "2",
            "children": [
              {
                "title": "Nouns for animals",
                "content": "I like cats. I like birds.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Simple present questions",
                "content": "Do you have a pet? Yes, I do. / No, I don't.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "What's this/that?",
                "content": "What's this? It's a fox / red panda.",
                "difficulty": "1",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "title": "Unit 4: Plants around us",
        "content": "Learning about fruit, how plants grow, and how we can help them.",
        "difficulty": "1",
        "children": [
          {
            "title": "Fruit",
            "content": "Learn names of common fruits.",
            "difficulty": "1",
            "children": [
              {
                "title": "Fruit vocabulary",
                "content": "apples, bananas, oranges, grapes.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Expressing likes and dislikes",
                "content": "Do you like apples? Yes, I do. / No, I don't. I like bananas.",
                "difficulty": "1",
                "children": []
              }
            ]
          },
          {
            "title": "Helping plants grow",
            "content": "Learn what plants need and how we can help them.",
            "difficulty": "1",
            "children": [
              {
                "title": "Needs of plants",
                "content": "Plants need air, water, sun.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Actions to help plants",
                "content": "We can water the flowers. We can plant trees.",
                "difficulty": "1",
                "children": []
              }
            ]
          },
          {
            "title": "Phonics: Letters Mm-Pp",
            "content": "Learn the sounds and writing of letters Mm, Nn, Oo, Pp.",
            "difficulty": "1",
            "children": [
              {
                "title": "Letter Mm",
                "content": "Sound /m/ as in map, mum.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Letter Nn",
                "content": "Sound /n/ as in new, fan.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Letter Oo",
                "content": "Sound /ɒ/ as in orange, fox.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Letter Pp",
                "content": "Sound /p/ as in pen, cup.",
                "difficulty": "1",
                "children": []
              }
            ]
          },
          {
            "title": "Grammar: Nouns and modals",
            "content": "Learn to use nouns for fruit and modals for suggestions.",
            "difficulty": "2",
            "children": [
              {
                "title": "Nouns for fruit",
                "content": "I like bananas.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Modals for suggestions",
                "content": "We can water the flowers.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Simple present questions",
                "content": "Do you like apples? Yes, I do. / No, I don't.",
                "difficulty": "1",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "title": "Unit 5: The colourful world",
        "content": "Learning about colours, how to identify them, and express preferences.",
        "difficulty": "1",
        "children": [
          {
            "title": "Colours",
            "content": "Learn names of common colours.",
            "difficulty": "1",
            "children": [
              {
                "title": "Colour vocabulary",
                "content": "red, orange, yellow, green, blue, purple, pink, white, black, brown.",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "Asking about colours",
                "content": "What colour is it? It's orange.",
                "difficulty": "1",
