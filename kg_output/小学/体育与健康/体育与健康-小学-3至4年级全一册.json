{
  "knowledge_tree": {
    "title": "体育与健康-3至4年级全一册",
    "content": "涵盖体育与健康基础知识、基本身体活动、体操类活动、球类活动、武术、民族民间体育活动等内容",
    "difficulty": "1",
    "children": [
      {
        "title": "体育与健康基础知识",
        "content": "健康知识、运动安全、卫生习惯等内容",
        "difficulty": "1",
        "children": [
          {
            "title": "安全运动促健康",
            "content": "运动前后的安全注意事项和运动好处",
            "difficulty": "1",
            "children": [
              {
                "title": "运动好处",
                "content": "促进生长发育、增强体质、调节情绪等",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "运动安全注意事项",
                "content": "运动前着装、准备活动；运动中集中注意力、遵守规则；运动后放松、饮食卫生",
                "difficulty": "2",
                "children": []
              }
            ]
          },
          {
            "title": "运动前后的饮食卫生",
            "content": "运动前后合理的饮食和饮水方法",
            "difficulty": "2",
            "children": [
              {
                "title": "运动前后饮水",
                "content": "运动前少喝水，运动后适量喝温开水或淡盐水",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "运动前后进食",
                "content": "运动前不大量进食，运动后休息半小时再吃饭",
                "difficulty": "2",
                "children": []
              }
            ]
          },
          {
            "title": "保持健康体重",
            "content": "营养不良与肥胖的原因、危害及预防",
            "difficulty": "2",
            "children": [
              {
                "title": "营养不良与肥胖的原因",
                "content": "偏食、挑食、饮食不规律、运动不足等",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "预防方法",
                "content": "均衡饮食、加强锻炼",
                "difficulty": "2",
                "children": []
              }
            ]
          },
          {
            "title": "国家学生体质健康标准",
            "content": "意义、测试项目和要求",
            "difficulty": "2",
            "children": [
              {
                "title": "测试项目",
                "content": "体重指数、肺活量、50米跑、坐位体前屈、1分钟跳绳、1分钟仰卧起坐",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "等级评定",
                "content": "90分及以上为优秀，80-89.9分为良好，60-79.9分为及格",
                "difficulty": "2",
                "children": []
              }
            ]
          },
          {
            "title": "用眼卫生",
            "content": "保护视力、预防近视的方法",
            "difficulty": "1",
            "children": [
              {
                "title": "读书写字姿势",
                "content": "身体坐直、眼离书本一尺、胸离桌边一拳、手离笔尖一寸",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "看电视用眼卫生",
                "content": "时间不宜过长、保持距离、姿势正确等",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "使用电脑用眼卫生",
                "content": "注意坐姿、休息眼睛、光线适宜等",
                "difficulty": "1",
                "children": []
              }
            ]
          },
          {
            "title": "呼吸道传染病的预防",
            "content": "常见呼吸道传染病及预防方法",
            "difficulty": "2",
            "children": [
              {
                "title": "常见呼吸道传染病",
                "content": "流行性感冒、新型冠状病毒肺炎、流行性腮腺炎等",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "预防方法",
                "content": "接种疫苗、避免接触感染者、保持良好的个人卫生、佩戴口罩等",
                "difficulty": "2",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "title": "基本身体活动",
        "content": "跑、跳跃、投掷等基本身体活动技能",
        "difficulty": "2",
