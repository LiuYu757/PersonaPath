              {
                "title": "50米快速跑",
                "content": "站立式起跑、途中跑、冲刺",
                "difficulty": "3",
                "children": []
              },
              {
                "title": "300-400米耐久跑",
                "content": "匀速跑、呼吸节奏、体力分配",
                "difficulty": "3",
                "children": []
              },
              {
                "title": "接力跑",
                "content": "迎面接力、往返接力",
                "difficulty": "3",
                "children": []
              },
              {
                "title": "障碍跑",
                "content": "跨、跳、钻、翻、爬等方法通过障碍",
