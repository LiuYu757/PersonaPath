{
  "knowledge_tree": {
    "title": "三年级下册数学",
    "content": "人教版三年级下册数学，涵盖除数是一位数的除法、两位数乘两位数、面积、年、月、日、小数的初步认识等核心内容",
    "difficulty": "2",
    "children": [
      {
        "title": "除数是一位数的除法",
        "content": "包括口算除法和笔算除法，掌握除法运算的基本方法",
        "difficulty": "2",
        "children": [
          {
            "title": "口算除法",
            "content": "整十、整百数除以一位数的口算方法",
            "difficulty": "1",
            "children": [
              {
                "title": "整十数除以一位数",
                "content": "如60÷3=20，利用数的组成计算",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "整百数除以一位数",
                "content": "如600÷3=200，利用数的组成计算",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "估算除法",
                "content": "如267÷3≈90，将267看作270进行估算",
                "difficulty": "2",
                "children": []
              }
            ]
          },
          {
            "title": "笔算除法",
            "content": "两位数或三位数除以一位数的竖式计算",
            "difficulty": "2",
            "children": [
              {
                "title": "两位数除以一位数",
                "content": "如42÷2=21，用竖式计算",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "三位数除以一位数",
                "content": "如256÷2=128，用竖式计算",
                "difficulty": "3",
                "children": []
              },
              {
                "title": "有余数的除法",
                "content": "如148÷6=24余4，掌握有余数除法的计算和验算",
                "difficulty": "3",
                "children": []
              },
              {
                "title": "商中间或末尾有0的除法",
                "content": "如208÷2=104，216÷2=108，掌握特殊情况的处理",
                "difficulty": "3",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "title": "两位数乘两位数",
        "content": "包括口算乘法和笔算乘法，掌握乘法运算的基本方法",
        "difficulty": "2",
        "children": [
          {
            "title": "口算乘法",
            "content": "整十、整百数乘整十数的口算方法",
            "difficulty": "1",
            "children": [
              {
                "title": "整十数乘整十数",
                "content": "如20×30=600，利用表内乘法计算",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "整百数乘整十数",
                "content": "如200×30=6000，利用表内乘法计算",
                "difficulty": "1",
                "children": []
              }
            ]
          },
          {
            "title": "笔算乘法",
            "content": "两位数乘两位数的竖式计算",
            "difficulty": "3",
            "children": [
              {
                "title": "不进位乘法",
                "content": "如12×14=168，用竖式计算",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "进位乘法",
                "content": "如37×48=1776，用竖式计算",
                "difficulty": "3",
                "children": []
              }
            ]
          }
        ]
      },
      {
        "title": "面积",
        "content": "包括面积和面积单位、长方形和正方形面积的计算、面积单位间的进率",
        "difficulty": "2",
        "children": [
          {
            "title": "面积和面积单位",
            "content": "认识面积的含义，认识面积单位平方厘米、平方分米、平方米",
            "difficulty": "1",
            "children": [
              {
                "title": "面积的含义",
                "content": "物体表面或封闭图形的大小就是它们的面积",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "平方厘米",
                "content": "边长1厘米的正方形，面积是1平方厘米",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "平方分米",
                "content": "边长1分米的正方形，面积是1平方分米",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "平方米",
                "content": "边长1米的正方形，面积是1平方米",
                "difficulty": "1",
                "children": []
              }
            ]
          },
          {
            "title": "长方形和正方形面积的计算",
            "content": "掌握长方形和正方形面积的计算公式",
            "difficulty": "2",
            "children": [
              {
                "title": "长方形面积公式",
                "content": "长方形的面积=长×宽",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "正方形面积公式",
                "content": "正方形的面积=边长×边长",
                "difficulty": "2",
                "children": []
              }
            ]
          },
          {
            "title": "面积单位间的进率",
            "content": "掌握平方厘米、平方分米、平方米之间的进率",
            "difficulty": "2",
            "children": [
              {
                "title": "平方厘米与平方分米",
                "content": "1平方分米=100平方厘米",
                "difficulty": "2",
                "children": []
              },
              {
                "title": "平方分米与平方米",
                "content": "1平方米=100平方分米",
                "difficulty": "2",
                "children": []
              }
            ]
          }
        ]
      },
