  "knowledge_tree": {
    "title": "习近平新时代中国特色社会主义思想学生读本（小学低年级）",
    "content": "小学低年级学生读本，聚焦爱国主义、党的领导、新时代特征、中国梦、少先队使命和新时代好少年要求",
    "difficulty": "1",
    "children": [
      {
        "title": "美丽中国是我家",
        "content": "介绍中国的基本国情、国旗、国歌、国徽等国家象征，以及国土资源和人民勤劳建设家园的故事",
        "difficulty": "1",
        "children": [
          {
            "title": "国家的象征",
            "content": "国旗是五星红旗，国徽中间是五星照耀下的天安门，周围是谷穗和齿轮",
            "difficulty": "1",
            "children": [
              {
                "title": "国旗的含义",
                "content": "五颗五角星象征中国共产党领导下的革命人民大团结",
                "difficulty": "1",
                "children": []
              },
              {
                "title": "国徽的组成",
                "content": "天安门代表民族精神，谷穗和齿轮象征工农联盟",
                "difficulty": "1",
                "children": []
              }
            ]
          },
          {
            "title": "国歌《义勇军进行曲》",
            "content": "由田汉作词、聂耳作曲，创作于抗日战争时期，号召中国人民万众一心保卫祖国",
            "difficulty": "1",
            "children": []
          },
          {
            "title": "国土与资源",
            "content": "中国国土辽阔，物产丰富，包括草原、平原、矿产、河流等资源",
            "difficulty": "1",
            "children": []
          }
        ]
      },
